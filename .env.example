# Copy to .env and adjust as needed: cp .env.example .env

# URL subpath if served behind a reverse proxy at a path (e.g. /crl).
# Leave empty when the app has its own (sub)domain or is served at root.
URL_PREFIX=

# How often (seconds) the scheduler looks for monitors due to be checked.
SCHEDULER_INTERVAL=30

# Per-request CRL HTTP timeout (seconds).
CRL_TIMEOUT=30

# Default maximum CRL download size (bytes); larger CRLs are rejected (16 MiB
# default). Overridable at runtime in the Settings UI for large CRLs.
MAX_CRL_BYTES=16777216

# Number of status-history rows retained per monitor.
HISTORY_LIMIT=200

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Authentication (see docs/AUTH.md)
# --------------------------------------------------------------------------- #
# Auth is OFF by default. It turns ON as soon as you set a break-glass admin
# password or configure OIDC. With auth OFF the app REFUSES TO START unless you
# explicitly opt into open mode (anyone who can reach the port gets full access):
#
#   CRL_ALLOW_OPEN_MODE=true        # isolated/single-user boxes only
#
# Signs the session cookie. Set a stable random value in production
# (e.g. `openssl rand -hex 32`); without one, sessions reset on every restart.
CRL_SESSION_SECRET=
# Break-glass local admin — the username/password fallback that works even when
# the IdP is down. Setting the password turns auth on and (re)creates the admin
# at startup. This is how you create the first admin before OIDC is wired.
CRL_BOOTSTRAP_ADMIN_USERNAME=admin
CRL_BOOTSTRAP_ADMIN_PASSWORD=
# Set the Secure flag on the session cookie (HTTPS). Keep true in production;
# set false only for plain-HTTP local testing.
CRL_SESSION_COOKIE_SECURE=true
# Session lifetime (seconds) and cookie name.
CRL_SESSION_TTL_SECONDS=28800
CRL_SESSION_COOKIE_NAME=crlmonitor_session
# Set false to force SSO-only (the break-glass admin still works for recovery).
CRL_LOCAL_LOGIN_ENABLED=true

# --- OIDC SSO (authentik or any standard issuer) --- #
# All three of ISSUER / CLIENT_ID / CLIENT_SECRET must be set for the SSO button
# to appear. Users are identified by the stable `sub` claim (never email).
CRL_OIDC_ISSUER=
CRL_OIDC_CLIENT_ID=
CRL_OIDC_CLIENT_SECRET=
CRL_OIDC_SCOPES=openid email profile
# Claim carrying group names (authentik's default `profile` scope emits names).
CRL_OIDC_GROUP_CLAIM=groups
# Optional: restrict OIDC logins to members of at least one of these groups
# (comma-separated). Empty => any authenticated IdP user may sign in.
CRL_OIDC_ALLOWED_GROUPS=
# Absolute public URL, used to build the OIDC redirect URI. Set this when the
# app can't infer its external URL from the proxy headers.
# e.g. https://crlmonitor.goodloe.xyz
CRL_PUBLIC_BASE_URL=
